# Endpoint paths
VITE_USERS_ENDPOINT_PATH="/users"
VITE_ROOMS_ENDPOINT_PATH="/rooms"
VITE_TASKS_ENDPOINT_PATH="/tasks"
VITE_PROFILES_ENDPOINT_PATH="/profiles"
