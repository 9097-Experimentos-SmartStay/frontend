# Copia este archivo a .env.development (npm run dev) o .env.production (npm run build)
# y completa los valores. Los archivos .env.* reales NO se versionan.

# URL base de la API de SmartStay.
# - Desarrollo: ruta relativa; el proxy de Vite la reenvía a VITE_DEV_PROXY_TARGET.
# - Producción (Vercel): URL absoluta del backend, por ejemplo https://<backend>.onrender.com/api/v1
VITE_SMARTSTAY_API_URL="/api/v1"

# Solo desarrollo: a dónde reenvía el proxy de Vite las llamadas a VITE_SMARTSTAY_API_URL.
# Sin ruta (http://localhost:10000) se conserva /api/v1; con ruta (https://host/api/v1) esa ruta reemplaza al prefijo.
VITE_DEV_PROXY_TARGET="http://localhost:10000"

# Cloudinary (subida de imágenes de hoteles con un upload preset sin firma).
VITE_CLOUDINARY_CLOUD_NAME=""
VITE_CLOUDINARY_UPLOAD_PRESET=""

# Opcionales: rutas de los endpoints (relativas a VITE_SMARTSTAY_API_URL).
# Si no se definen se usan estos valores por defecto.
# VITE_AUTHENTICATION_ENDPOINT_PATH="/authentication"
# VITE_USERS_ENDPOINT_PATH="/users"
# VITE_AUDIT_LOGS_ENDPOINT_PATH="/audit-logs"
# VITE_GUESTS_ENDPOINT_PATH="/guests"
# VITE_STAFF_ENDPOINT_PATH="/staff"
# VITE_HOTELS_ENDPOINT_PATH="/hotels"
# VITE_ROOMS_ENDPOINT_PATH="/rooms"
# VITE_ROOM_TYPES_ENDPOINT_PATH="/room-types"
# VITE_BOOKINGS_ENDPOINT_PATH="/bookings"
# VITE_PAYMENTS_ENDPOINT_PATH="/payments"
# VITE_ANALYTICS_ENDPOINT_PATH="/analytics"

# Registro de pagos por recepción (Yape, Plin, transferencia, efectivo, tarjeta en recepción).
# El contrato del backend aún no lo publica: mientras no se defina, el diálogo "Registrar pago" no se puede enviar.
# VITE_PAYMENT_REGISTRATION_ENDPOINT_PATH=""
