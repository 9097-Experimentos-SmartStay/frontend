# .env.development

# --- SmartStay API Configuration ---
# Base URL for the backend API.
# For local development using json-server, use http://localhost:<port>
VITE_SMARTSTAY_API_URL="http://localhost:3000" # <-- CORREGIDO A PUERTO 3000

# --- API Endpoint Paths (Relative to VITE_SMARTSTAY_API_URL) ---
VITE_USERS_ENDPOINT_PATH="/users"
VITE_PROPERTIES_ENDPOINT_PATH="/properties"
VITE_ROOMS_ENDPOINT_PATH="/rooms"
VITE_BOOKINGS_ENDPOINT_PATH="/bookings"
VITE_REVIEWS_ENDPOINT_PATH="/reviews"
VITE_PAYMENTS_ENDPOINT_PATH="/payments"
VITE_INVOICES_ENDPOINT_PATH="/invoices"
# ... otros endpoints ...